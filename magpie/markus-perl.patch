diff --git a/src/30-helpers.sh b/src/30-helpers.sh
index 13cba85..35aac0b 100644
--- a/src/30-helpers.sh
+++ b/src/30-helpers.sh
@@ -202,6 +202,19 @@ download() {
         echo "No download URL supplied." >&2
         exit 1
     fi
+    # GNU's own servers time out often enough to fail a build, so kernel.org's mirror of the
+    # same tree is tried first. The package checksum verifies the file whichever source gave it.
+    for DOWNLOAD_URL in "${DOWNLOAD_URLS[@]}"; do
+        case "$DOWNLOAD_URL" in
+        https://ftp.gnu.org/gnu/* | https://ftpmirror.gnu.org/gnu/*)
+            DOWNLOAD_URLS=("https://mirrors.kernel.org/gnu/${DOWNLOAD_URL#*/gnu/}" "${DOWNLOAD_URLS[@]}")
+            DOWNLOAD_SHAS=("" "${DOWNLOAD_SHAS[@]}")
+            DOWNLOAD_SHA_EXPLICIT=(0 "${DOWNLOAD_SHA_EXPLICIT[@]}")
+            break
+            ;;
+        esac
+    done
+
 
     if [ -z "$DOWNLOAD_FILE" ]; then
         DOWNLOAD_FILE="${DOWNLOAD_URLS[0]##*/}"
@@ -219,6 +232,25 @@ download() {
     DOWNLOAD_SHA_VAR=$(package_sha_var "$CURRENT_PACKAGE_NAME")
     DOWNLOAD_PACKAGE_SHA="${!DOWNLOAD_SHA_VAR}"
 
+    # Magpie's mirror (MAGPIE_MIRROR_LIST, magpie/mirror.json) is tried first for an archive it
+    # lists. Its sha256 checks the mirror copy and any upstream source that has no checksum.
+    if [ -n "${MAGPIE_MIRROR_LIST:-}" ]; then
+        MIRROR_SHA="$(jq -r --arg n "$DOWNLOAD_FILE" '.archives[$n] // empty' "$MAGPIE_MIRROR_LIST" 2>/dev/null || true)"
+        if [ -n "$MIRROR_SHA" ]; then
+            for DOWNLOAD_INDEX in "${!DOWNLOAD_URLS[@]}"; do
+                if [ "${DOWNLOAD_SHA_EXPLICIT[$DOWNLOAD_INDEX]}" -eq 0 ] && [ -z "$DOWNLOAD_PACKAGE_SHA" ]; then
+                    DOWNLOAD_SHAS[DOWNLOAD_INDEX]="$MIRROR_SHA"
+                    DOWNLOAD_SHA_EXPLICIT[DOWNLOAD_INDEX]=1
+                fi
+            done
+            DOWNLOAD_URLS=("$(jq -r .url "$MAGPIE_MIRROR_LIST")/$DOWNLOAD_FILE" "${DOWNLOAD_URLS[@]}")
+            DOWNLOAD_SHAS=("$MIRROR_SHA" "${DOWNLOAD_SHAS[@]}")
+            DOWNLOAD_SHA_EXPLICIT=(1 "${DOWNLOAD_SHA_EXPLICIT[@]}")
+        else
+            echo "mirror: $DOWNLOAD_FILE is not in magpie/mirror.json"
+        fi
+    fi
+
     DOWNLOAD_FILE_NEEDS_DOWNLOAD=0
     if [ -f "$DOWNLOAD_PATH/$DOWNLOAD_FILE" ] && [ -s "$DOWNLOAD_PATH/$DOWNLOAD_FILE" ]; then
         echo "$DOWNLOAD_FILE has already been downloaded and is not empty."
diff --git a/src/95-ffmpeg.sh b/src/95-ffmpeg.sh
index efe472b..17f94f1 100644
--- a/src/95-ffmpeg.sh
+++ b/src/95-ffmpeg.sh
@@ -11,11 +11,13 @@
 # the .git -> .git.bak dance below, which keeps ffmpeg from describing *this*
 # repository instead of its own tree.
 
-EXTRA_VERSION=""
-if [[ "$OSTYPE" == "darwin"* ]]; then
-    EXTRA_VERSION="${FFMPEG_VERSION}"
+# Stops once every dependency is built, so they can be cached before ffmpeg is.
+if [ -n "${MAGPIE_DEPENDENCIES_ONLY:-}" ]; then
+    exit 0
 fi
 
+EXTRA_VERSION="${MAGPIE_EXTRA_VERSION:?}"
+
 if [ -d "$CWD/.git" ]; then
     echo -e "\nTemporarily moving .git dir to .git.bak to workaround ffmpeg build bug" #causing ffmpeg version number to be wrong
     mv "$CWD/.git" "$CWD/.git.bak"
@@ -45,7 +47,9 @@ if [ "$FFMPEG_VERSION" = "snapshot" ]; then
 else
     FFMPEG_ARCHIVE="FFmpeg-release-$FFMPEG_VERSION.tar.gz"
 fi
-download "$(ffmpeg_tarball_url "$FFMPEG_VERSION")" "$FFMPEG_ARCHIVE"
+download "${MAGPIE_TARBALL_URL:?}|${MAGPIE_TARBALL_SHA256:?}"
+# The release tarball's VERSION file reads 8.1.3; name the git tag as the other targets do.
+echo "${MAGPIE_FFMPEG_TAG:?}" >VERSION
 
 # Keyed on X11 actually being absent, not on the architecture: an Intel Mac with
 # XQuartz keeps x11grab/xcbgrab/xv. vaapi needs no disable - build_vaapi() in
@@ -58,7 +62,7 @@ fi
 
 # shellcheck disable=SC2086
 
-execute ./configure "${CONFIGURE_OPTIONS[@]}" \
+execute ./configure "${CONFIGURE_OPTIONS[@]}" ${MAGPIE_CONFIGURE_FLAGS:?} \
     --disable-debug \
     --disable-shared \
     --enable-pthreads \
